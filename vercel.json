{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/auth.html",        "dest": "/frontend/auth.html" },
    { "src": "/assets/(.*)",      "dest": "/frontend/assets/$1" },
    { "src": "/js/(.*)",          "dest": "/frontend/js/$1" },
    { "src": "/style.css",        "dest": "/frontend/style.css" },
    { "src": "/(.*)\\.html",      "dest": "/frontend/$1.html" },
    { "src": "/(.*)",             "dest": "/frontend/index.html" }
  ]
}
