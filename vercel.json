{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/js/(.*)",   "dest": "/frontend/js/$1" },
    { "src": "/style.css", "dest": "/frontend/style.css" },
    { "src": "/(.*)",      "dest": "/frontend/index.html" }
  ]
}
